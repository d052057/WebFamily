+<div class="container py-3 fade-in-out">
+    <audio controls #AngAudioPlayer></audio>
+    <div class="card shadow-sm">
+
+        <div class="card-body d-flex">
+            <!-- Track info -->
+            <div class="cover-col">
+                <app-rpm-cover-carousel [covers]="covers"
+                                        [selectedId]="selectedCoverId"
+                                        (coverSelected)="coverSelected.emit($event)">
+                </app-rpm-cover-carousel>
+            </div>
+            <div class="flex-grow-1 player-col">
+                <article class="jumbotron" style="padding-top:2px; padding-left:2px;padding-right:2px">
+                    @if (albumTitle) {
+                    <h6 class="album-title-banner mb-2">{{ albumTitle }}</h6>
+                    }
+                    @if (currentAudio()) {
+                    <div class="text-center">
+                        <h5 class="card-title mb-1">{{ (currentAudio().title) || 'No track selected' }}</h5>
+                        @if (currentAudio().artist) {
+                        <p class="text-muted mb-1">{{ currentAudio().artist }}</p>
+                        }
+                        <small class="text-muted">{{ currentAudioTime() | timeConversion }} / {{ totalAudioLength() | timeConversion }}</small>
+                    </div>
+                    }
+                </article>
+                <!-- Progress bar -->
+                <div class="mb-3">
+                    <input type="range" class="form-range"
+                           [max]="totalAudioLength()"
+                           [value]="currentAudioTime()"
+                           (input)="seek($event)"
+                           [disabled]="!isAudioLoaded()">
+                </div>
+
+                <!-- Main controls -->
+                <div class="d-flex justify-content-center align-items-center gap-3 mb-4">
+                    <button class="btn btn-outline-secondary rounded-circle"
+                            (click)="toggleShuffle()"
+                            [class.active]="isShuffle()"
+                            title="Shuffle">
+                        <i class="bi bi-shuffle"></i>
+                    </button>
+
+                    <button class="btn btn-outline-secondary rounded-circle"
+                            (click)="playPrevious()"
+                            [disabled]="!canPlayPrevious()"
+                            title="Previous">
+                        <i class="bi bi-skip-start-fill"></i>
+                    </button>
+
+                    <button class="btn btn-outline-secondary rounded-circle play-pause-btn"
+                            (click)="togglePlay()"
+                            [disabled]="!isAudioLoaded()"
+                            [class.active]="isAudioPlaying()"
+                            title="Play/Pause">
+                        <i class="bi" [class.bi-pause-fill]="isAudioPlaying()" [class.bi-play-fill]="!isAudioPlaying()"></i>
+                    </button>
+
+                    <button class="btn btn-outline-secondary rounded-circle"
+                            (click)="playNext()"
+                            [disabled]="!canPlayNext()"
+                            title="Next">
+                        <i class="bi bi-skip-end-fill"></i>
+                    </button>
+
+                    <button class="btn btn-outline-secondary rounded-circle"
+                            (click)="toggleRepeat()"
+                            [class.active]="isRepeat()"
+                            title="Repeat">
+                        <i class="bi bi-arrow-repeat"></i>
+                    </button>
+                </div>
+
+                <!-- Secondary controls -->
+                <div class="d-flex justify-content-center align-items-center gap-3">
+                    <button class="btn btn-outline-secondary rounded-circle"
+                            (click)="toggleMute()"
+                            title="Mute/Unmute">
+                        <i class="bi" [class.bi-volume-mute-fill]="isMute()" [class.bi-volume-up-fill]="!isMute()"></i>
+                    </button>
+
+                    <input type="range" class="form-range volume-slider"
+                           min="0" max="100"
+                           [value]="audioVolume()"
+                           (input)="setVolume($event)"
+                           style="width: 100px">
+
+                    <button class="btn btn-outline-secondary rounded-circle"
+                            (click)="playRandom()"
+                            [disabled]="!canPlayNext()"
+                            title="Play Random">
+                        <i class="bi bi-shuffle"></i>
+                    </button>
+
+                    <button class="btn btn-outline-secondary rounded-circle"
+                            (click)="toggleAutoPlay()"
+                            [class.active]="isAudioAutoPlay()"
+                            title="Autoplay">
+                        <i class="bi bi-play-circle"></i>
+                    </button>
+                </div>
+            </div>
+
+        </div>
+
+        <!-- Playlist -->
+        @if (showPlaylist && audioList().length) {
+        <div class="card-footer bg-transparent">
+        <div class="row">
+            <app-search-box label="Search for" (searchChange)="searchVal.set($event)"></app-search-box>
+        </div>
+            <h6 class="card-subtitle mb-2 text-muted">
+                Playlist - Track {{ currentAudio()?.trackNumber ?? (currentTrackIndex() + 1) }} of {{ audioList().length }}
+            </h6>
+            <div #trackListContainer class="list-group playlist-items" style="max-height: 200px; overflow-y: auto;">
+                @for (item of audioList(); track item; let i = $index) {
+                <button type="button"
+                        class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
+                        [class.active]="i === currentTrackIndex()"
+                        (click)="playTrack(i)">
+                    <span class="me-2">{{ item.trackNumber ?? (i + 1) }}.</span>
+                    <span class="flex-grow-1 text-start">{{ (item?.title ) || 'Untitled track' }}</span>
+                    <span class="badge bg-secondary rounded-pill">{{ item.duration | timeConversion }}</span>
+                </button>
+                }
+            </div>
+        </div>
+        }
+    </div>
+</div>
