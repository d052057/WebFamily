{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "Email": {
    "From": "renton9232@gmail.com",
    "ApplicationName": "IdentityApp",
    "ConfirmEmailPath": "account/confirm-email",
    "ResetPasswordPath": "account/reset-password"
  },

  "MailJet": {
    "ApiKey": "",
    "SecretKey": ""
  },

  "Facebook": {
    "AppId": "",
    "AppSecret": ""
  },

  "Google": {
    "ClientId": ""
  },
  "GoogleMaps": {
    "ApiKey": ""
  },
  "YouTube": {
    "ApiKey": ""
  },
  "JWT": {
    "Key": "",
    "ExpiresInDays": 15,
    "Issuer": "http://localhost",
    "ClientUrl": "https://localhost"
  },
  "ApplicationSettings": {
    "Download": "Yes",
    //"ClientURL": "*",
    "AssetRpmFolder": "musics\\rpm",
    "MediaDrive": "d:\\medias",
    "AssetVideoFolder": "videos",
    "AssetMovieFolder": "movies",
    "AssetBookFolder": "books",
    "AssetAlbumFolder": "musics",
    "TrashFolder": "d:\\medias\\_Trash",
    "AssetPhotoFolder": "photos",
    "AssetRpmCoverFolder": "musics\\rpm\\cover",
    "AssetTextFolder": "books\\text",
    "ArtistLookupFilePath": "Data/artist-lookup.json",
    "MediaScanExtensions": {
      "Audio": [ ".mp3", ".flac", ".m4a", ".aac", ".wav", ".ogg", ".wma", ".aiff" ],
      "Video": [ ".mp4", ".mkv", ".mov", ".avi", ".wmv", ".m4v", ".webm", ".flv", ".mpg", ".mpeg", ".3gp" ],
      "Book": [ ".pdf", ".epub", ".mobi", ".azw3", ".djvu", ".cbz", ".cbr", ".txt" ],
      "Photo": [ ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".tiff" ]
    }
  },
  "CorsUrls": {
    "AllowedOrigins": [
      "https://localhost",
      "https://127.0.0.1",
      "http://localhost",
      "http://127.0.0.1",
      "https://webfamily",
      "http://webfamily",
      "http://webfamily.com"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "webdownloadRoute": {
        "ClusterId": "webdownloadCluster",
        "Match": {
          "Path": "/webdownload/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/webdownload"
          }
        ]
      },
      "jellyfinRoute": {
        "ClusterId": "jellyfinCluster",
        "Match": {
          "Path": "/jellyfin/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/jellyfin"
          }
        ]
      }
    },
    "Clusters": {
      "webdownloadCluster": {
        "Destinations": {
          "webdownloadDestination": {
            "Address": "http://localhost:8090"
          }
        }
      },
      "jellyfinCluster": {
        "Destinations": {
          "jellyfinDestination": {
            "Address": "http://localhost:8096/"
          }
        }
      }
    }
  }
}
